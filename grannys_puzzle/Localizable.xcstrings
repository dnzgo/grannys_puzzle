    },
    "You're doing wonderfully. One more go, I believe in you!" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harika gidiyorsun. Bir kez daha dene, sana inanıyorum!"
